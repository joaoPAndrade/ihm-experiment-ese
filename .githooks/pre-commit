#!/usr/bin/env bash
set -e

echo "🔍 Executando Quality Gate de Desenvolvimento..."
python3 scripts/quality_gate_validator.py
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "❌ Commit abortado: o código viola as diretrizes obrigatórias do projeto (.AGENTS)." >&2
    exit 1
fi

echo "✅ Quality Gate aprovado com sucesso!"
exit 0
